# Copy this file to `.env` and fill in your Supabase values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use the Supabase Postgres connection string here if you want direct DB access.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# AI provider selection: gemini, huggingface, or groq
AI_PROVIDER=gemini

# Provider keys
GEMINI_API_KEY=
HF_API_KEY=
# GROQ (optional) — endpoint to call and API key/token
GROQ_ENDPOINT=
GROQ_API_KEY=
